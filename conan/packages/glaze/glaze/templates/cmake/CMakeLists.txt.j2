cmake_minimum_required(VERSION 3.15)
project(glaze_apis C)

{% for api in apis %}
add_library(glaze_{{ api }} {{ lib_type }} {{ out_dir }}/src/{{ api }}.c)
target_include_directories(glaze_{{ api }} PUBLIC $<BUILD_INTERFACE:{{ out_dir }}/include>)
target_include_directories(glaze_{{ api }} INTERFACE $<INSTALL_INTERFACE:include>)
{% if shared %}
target_compile_definitions(glaze_{{ api }} PRIVATE GLAZE_BUILD_DLL)
{% endif %}

{% endfor %}
