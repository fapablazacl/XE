// ── Type-safe bitmask flags ──────────────────────────────────────────────────

/**
 * @brief Type-safe bitmask wrapper for enum classes marked as bitfields.
 * @tparam E An enum class whose values represent individual bit flags.
 *
 * Supports all bitwise operators (`|`, `&`, `^`, `~`) and their
 * compound-assignment variants. A single enum value converts implicitly
 * to Flags, so `ClearBufferMask::eColor | ClearBufferMask::eDepth` works
 * out of the box.
 */
template<typename E>
class Flags {
    using underlying = typename std::underlying_type<E>::type;
    underlying m_value;
public:
    /** @brief Constructs an empty flag set (no bits set). */
    Flags() : m_value(0) {}
    /** @brief Implicit conversion from a single enum bit value. */
    Flags(E bit) : m_value(static_cast<underlying>(bit)) {}
    /** @brief Constructs from a raw underlying integer (explicit). */
    explicit Flags(underlying v) : m_value(v) {}

    /** @brief Returns the raw underlying integer value. */
    underlying value() const { return m_value; }
    /** @brief Returns true if any bit is set. */
    explicit operator bool() const { return m_value != 0; }
    explicit operator underlying() const { return m_value; }

    Flags operator|(Flags rhs) const { return Flags(m_value | rhs.m_value); }
    Flags operator&(Flags rhs) const { return Flags(m_value & rhs.m_value); }
    Flags operator^(Flags rhs) const { return Flags(m_value ^ rhs.m_value); }
    Flags operator~() const { return Flags(~m_value); }
    Flags& operator|=(Flags rhs) { m_value |= rhs.m_value; return *this; }
    Flags& operator&=(Flags rhs) { m_value &= rhs.m_value; return *this; }
    Flags& operator^=(Flags rhs) { m_value ^= rhs.m_value; return *this; }
    bool operator==(Flags rhs) const { return m_value == rhs.m_value; }
    bool operator!=(Flags rhs) const { return m_value != rhs.m_value; }
};

// ── Array view for data upload helpers ───────────────────────────────────────

/**
 * @brief Lightweight non-owning view over a contiguous array of T.
 * @tparam T Element type.
 *
 * Used by data-upload overloads (e.g. bufferData) to accept typed arrays
 * instead of raw `void*` + byte-size pairs. Implicitly constructible from
 * C arrays and from pointer + count.
 */
template<typename T>
struct ArrayView {
    const T* m_data; /**< Pointer to the first element. */
    std::size_t m_size; /**< Number of elements (not bytes). */

    /** @brief Constructs a view from a pointer and element count. */
    ArrayView(const T* data, std::size_t count) : m_data(data), m_size(count) {}
    /** @brief Constructs a view from a C array, deducing the count automatically. */
    template<std::size_t N>
    ArrayView(const T (&arr)[N]) : m_data(arr), m_size(N) {}

    /** @brief Returns a pointer to the first element. */
    const T* data() const { return m_data; }
    /** @brief Returns the number of elements. */
    std::size_t size() const { return m_size; }
    /** @brief Returns the total size in bytes (`size() * sizeof(T)`). */
    std::size_t size_bytes() const { return m_size * sizeof(T); }
    const T* begin() const { return m_data; }
    const T* end() const { return m_data + m_size; }
};

