// ── Strong handle types ──────────────────────────────────────────────────────

/**
 * @brief Type-safe wrapper for OpenGL object names (GLuint handles).
 * @tparam Tag Empty tag type that distinguishes unrelated handle kinds at compile time.
 *
 * Prevents accidental mixing of, e.g., a Buffer handle with a Texture handle.
 * Conversion to/from the raw GLuint is always explicit.
 */
template<typename Tag>
struct Handle {
    GLuint id; /**< Raw OpenGL object name. */
    /** @brief Constructs a null handle (id == 0). */
    Handle() : id(0) {}
    /** @brief Constructs a handle from a raw OpenGL name. */
    explicit Handle(GLuint id) : id(id) {}
    /** @brief Extracts the raw GLuint (explicit to prevent silent conversions). */
    explicit operator GLuint() const { return id; }
    bool operator<(Handle o) const { return id < o.id; }
    bool operator==(Handle o) const { return id == o.id; }
    bool operator!=(Handle o) const { return id != o.id; }
    /** @brief Returns true if the handle refers to a valid object (id != 0). */
    explicit operator bool() const { return id != 0; }
};

{% for tag, alias in handle_types %}
struct {{ tag }}Tag {};
using {{ alias }} = Handle<{{ tag }}Tag>;
{% endfor %}

// ── Location types (uniform / attrib) ────────────────────────────────────────
{% if location_types %}

/**
 * @brief Type-safe wrapper for shader variable locations (GLint).
 * @tparam Tag Empty tag type that distinguishes uniform locations from attribute locations.
 *
 * A default-constructed Location holds -1 (invalid). The bool conversion
 * returns true only for non-negative (valid) locations.
 */
template<typename Tag>
struct Location {
    GLint loc; /**< Raw location index (-1 == invalid). */
    /** @brief Constructs an invalid location (loc == -1). */
    Location() : loc(-1) {}
    /** @brief Constructs a location from a raw GLint. */
    explicit Location(GLint loc) : loc(loc) {}
    /** @brief Extracts the raw GLint (explicit to prevent silent conversions). */
    explicit operator GLint() const { return loc; }
    bool operator==(Location o) const { return loc == o.loc; }
    bool operator!=(Location o) const { return loc != o.loc; }
    /** @brief Returns true if the location is valid (loc >= 0). */
    explicit operator bool() const { return loc >= 0; }
};

{% for tag, alias in location_types %}
struct {{ tag }}Tag {};
using {{ alias }} = Location<{{ tag }}Tag>;
{% endfor %}
{% endif %}

