#ifndef __gl_hpp__
#define __gl_hpp__
#include <glaze/gl.h>
#include <string>
#include <cassert>

namespace gl {

// ── Strong handle types ──────────────────────────────────────────────────────
template<typename Tag>
struct Handle {
    GLuint id;
    Handle() : id(0) {}
    explicit Handle(GLuint id) : id(id) {}
    explicit operator GLuint() const { return id; }
    bool operator==(Handle o) const { return id == o.id; }
    bool operator!=(Handle o) const { return id != o.id; }
    explicit operator bool() const { return id != 0; }
};

{% for tag, alias in handle_types %}
struct {{ tag }}Tag {};
using {{ alias }} = Handle<{{ tag }}Tag>;
{% endfor %}

// ── Location types (uniform / attrib) ────────────────────────────────────────
{% if location_types %}
template<typename Tag>
struct Location {
    GLint loc;
    Location() : loc(-1) {}
    explicit Location(GLint loc) : loc(loc) {}
    explicit operator GLint() const { return loc; }
    bool operator==(Location o) const { return loc == o.loc; }
    bool operator!=(Location o) const { return loc != o.loc; }
    explicit operator bool() const { return loc >= 0; }
};

{% for tag, alias in location_types %}
struct {{ tag }}Tag {};
using {{ alias }} = Location<{{ tag }}Tag>;
{% endfor %}
{% endif %}

// ── Debug error checking ──────────────────────────────────────────────────────
#ifndef NDEBUG
struct _GlErrorScope {
    ~_GlErrorScope() {
        GLenum err = glGetError();
        assert(err == GL_NO_ERROR);
    }
};
#define GLAZE_GL_CHECK ::gl::_GlErrorScope _glaze_e_
#else
#define GLAZE_GL_CHECK ((void)0)
#endif

// ── Enum classes ─────────────────────────────────────────────────────────────
{% for ec in enum_classes %}
enum class {{ ec.group_name }} : {{ ec.base_type }} {
{% for entry in ec.entries %}
    {{ entry.name }} = {{ entry.value }}{% if not loop.last %},{% endif %}

{% endfor %}
};

{% endfor %}
{% for fn in functors %}
struct _{{ fn.struct_name }} {
    constexpr _{{ fn.struct_name }}() noexcept = default;
    explicit operator bool() const noexcept { return ::{{ fn.gl_name }} != nullptr; }
{% for ov in fn.overloads %}
    {{ ov.return_type }} operator()({{ ov.params_str }}) const {
        GLAZE_GL_CHECK;
{% if ov.body %}
        {{ ov.body | replace('\n', '\n        ') }}
{% else %}
        return ::{{ fn.gl_name }}({{ ov.call_args_str }});
{% endif %}
    }
{% endfor %}
};
#if __cplusplus >= 201703L
inline constexpr _{{ fn.struct_name }} {{ fn.func_name }};
#else
constexpr _{{ fn.struct_name }} {{ fn.func_name }};
#endif

{% endfor %}
} // namespace gl
#endif
