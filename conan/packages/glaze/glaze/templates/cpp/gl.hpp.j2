// ── Type-safe bitmask flags ──────────────────────────────────────────────────
template<typename E>
class Flags {
    using underlying = typename std::underlying_type<E>::type;
    underlying m_value;
public:
    Flags() : m_value(0) {}
    Flags(E bit) : m_value(static_cast<underlying>(bit)) {}
    explicit Flags(underlying v) : m_value(v) {}

    underlying value() const { return m_value; }
    explicit operator bool() const { return m_value != 0; }
    explicit operator underlying() const { return m_value; }

    Flags operator|(Flags rhs) const { return Flags(m_value | rhs.m_value); }
    Flags operator&(Flags rhs) const { return Flags(m_value & rhs.m_value); }
    Flags operator^(Flags rhs) const { return Flags(m_value ^ rhs.m_value); }
    Flags operator~() const { return Flags(~m_value); }
    Flags& operator|=(Flags rhs) { m_value |= rhs.m_value; return *this; }
    Flags& operator&=(Flags rhs) { m_value &= rhs.m_value; return *this; }
    Flags& operator^=(Flags rhs) { m_value ^= rhs.m_value; return *this; }
    bool operator==(Flags rhs) const { return m_value == rhs.m_value; }
    bool operator!=(Flags rhs) const { return m_value != rhs.m_value; }
};

// ── Array view for data upload helpers ───────────────────────────────────────
template<typename T>
struct ArrayView {
    const T* m_data;
    std::size_t m_size;

    ArrayView(const T* data, std::size_t count) : m_data(data), m_size(count) {}
    template<std::size_t N>
    ArrayView(const T (&arr)[N]) : m_data(arr), m_size(N) {}

    const T* data() const { return m_data; }
    std::size_t size() const { return m_size; }
    std::size_t size_bytes() const { return m_size * sizeof(T); }
    const T* begin() const { return m_data; }
    const T* end() const { return m_data + m_size; }
};

