# Auto-generated by glazed's build() — declares one INTERFACE target per
# OpenGL API family. Each API target carries its own loader .c source via
# INTERFACE_SOURCES, so the consumer's CMake compiles exactly the loader it
# linked against and nothing else.
#
# Consumers select the GL version with a compile definition, e.g.
#     target_compile_definitions(my_app PRIVATE GLAZE_GL_VERSION=33)

get_filename_component(_GLAZED_PACKAGE_DIR "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
set(GLAZED_INCLUDE_DIR "${_GLAZED_PACKAGE_DIR}/include")
set(GLAZED_SRC_DIR     "${_GLAZED_PACKAGE_DIR}/src")

# Header-only API-agnostic smart pointers (glaze::Unique / Shared / Weak).
if(NOT TARGET glazed_raii)
    add_library(glazed_raii INTERFACE)
    target_include_directories(glazed_raii INTERFACE "${GLAZED_INCLUDE_DIR}")
    add_library(glazed::raii ALIAS glazed_raii)
endif()

{% for api in apis %}
# --- {{ api }} ---------------------------------------------------------------
if(NOT TARGET glazed_{{ api }})
    add_library(glazed_{{ api }} INTERFACE)
    target_include_directories(glazed_{{ api }} INTERFACE "${GLAZED_INCLUDE_DIR}")
    target_sources(glazed_{{ api }} INTERFACE "${GLAZED_SRC_DIR}/{{ api }}.c")
    add_library(glazed::{{ api }} ALIAS glazed_{{ api }})
endif()

if(NOT TARGET glazed_{{ api }}_handle)
    add_library(glazed_{{ api }}_handle INTERFACE)
    target_include_directories(glazed_{{ api }}_handle INTERFACE "${GLAZED_INCLUDE_DIR}")
    target_link_libraries(glazed_{{ api }}_handle INTERFACE glazed_{{ api }})
    add_library(glazed::{{ api }}_handle ALIAS glazed_{{ api }}_handle)
endif()

{% endfor %}
unset(_GLAZED_PACKAGE_DIR)
