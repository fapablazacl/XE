#pragma once
/*
 * {{ generation_header_formatted }}
 */

#ifndef __GLAZE_{{ api_upper }}_HPP__
#define __GLAZE_{{ api_upper }}_HPP__

#include <glaze/{{ api }}.h>
#include <glaze/raii.hpp>

#include <cstdint>
#include <string>
#include <type_traits>

namespace {{ api }} {

// ── Strong handle types ──────────────────────────────────────────────────────
{% for ht in handle_types %}
struct {{ ht.name }} {
    GLuint id = 0;
    constexpr {{ ht.name }}() = default;
    constexpr explicit {{ ht.name }}(GLuint v) : id(v) {}
    constexpr explicit operator bool() const { return id != 0; }
    friend constexpr bool operator==(const {{ ht.name }}& a, const {{ ht.name }}& b) { return a.id == b.id; }
    friend constexpr bool operator!=(const {{ ht.name }}& a, const {{ ht.name }}& b) { return a.id != b.id; }
};
{% endfor %}

// ── Location types ───────────────────────────────────────────────────────────
{% for lt in location_types %}
struct {{ lt.name }} {
    GLint loc = -1;
    constexpr {{ lt.name }}() = default;
    constexpr explicit {{ lt.name }}(GLint v) : loc(v) {}
    constexpr bool valid() const { return loc >= 0; }
};
{% endfor %}

// ── Flags template for bitmask enums ─────────────────────────────────────────
template <typename E>
class Flags {
public:
    constexpr Flags() = default;
    constexpr Flags(E e) : bits_(static_cast<GLbitfield>(e)) {}
    constexpr explicit Flags(GLbitfield v) : bits_(v) {}
    constexpr GLbitfield value() const { return bits_; }
    constexpr Flags operator|(Flags rhs) const { return Flags{static_cast<GLbitfield>(bits_ | rhs.bits_)}; }
    constexpr Flags& operator|=(Flags rhs) { bits_ |= rhs.bits_; return *this; }
private:
    GLbitfield bits_ = 0;
};

// ── Enum classes ─────────────────────────────────────────────────────────────
{% for ec in enum_classes %}
enum class {{ ec.group_name }} : {{ ec.base_type }} {
{% for entry in ec.entries %}
    {{ entry.name }} = {{ entry.value }}{% if not loop.is_last %},{% endif %}

{% endfor %}
};
{% if ec.is_bitmask %}
constexpr Flags<{{ ec.group_name }}> operator|({{ ec.group_name }} a, {{ ec.group_name }} b) {
    return Flags<{{ ec.group_name }}>{a} | Flags<{{ ec.group_name }}>{b};
}
{% endif %}
{% endfor %}

// ── Functors ─────────────────────────────────────────────────────────────────
{% for fn in functors %}
#if GLAZE_GL_VERSION >= {{ fn.version_int }}
struct {{ fn.struct_name }} {
{% for ov in fn.overloads %}
    inline {{ ov.return_type }} operator()({{ ov.params_str }}) const {
{% if ov.is_void_return %}
        {{ ov.raw_ptr }}({{ ov.call_args_str }});
{% else if ov.is_handle_return %}
        return {{ ov.return_type }}{{ "{" }}{{ ov.raw_ptr }}({{ ov.call_args_str }}){{ "}" }};
{% else %}
        return {{ ov.return_type }}({{ ov.raw_ptr }}({{ ov.call_args_str }}));
{% endif %}
    }
{% endfor %}
    explicit operator bool() const { return {{ fn.overloads.0.raw_ptr }} != nullptr; }
};
inline {{ fn.struct_name }} {{ fn.func_name }}{};
#endif
{% endfor %}

// ── DSA classes ──────────────────────────────────────────────────────────────
namespace dsa {
{% for dc in dsa_classes %}
class {{ dc.class_name }} {
public:
    {{ dc.handle_type }} m_id;
    {{ dc.class_name }}() = default;
    explicit {{ dc.class_name }}({{ dc.handle_type }} id) : m_id(id) {}

{% for m in dc.methods %}
#if GLAZE_GL_VERSION >= {{ m.version_int }}
    inline {{ m.return_type }} {{ m.name }}({{ m.params_str }}) const {
{% if m.is_void_return %}
        {{ m.raw_ptr }}({{ m.call_args_str }});
{% else %}
        return {{ m.raw_ptr }}({{ m.call_args_str }});
{% endif %}
    }
#endif
{% endfor %}
};
{% endfor %}
} // namespace dsa

// ── RAII Traits specializations for strong handle types ─────────────────────
} // namespace {{ api }}

namespace glaze {
{% for r in raii_resources %}
template <>
struct Traits<{{ api }}::{{ r.handle_type }}> {
    static {{ api }}::{{ r.handle_type }} create() { return {{ api }}::{{ r.gen_func_name }}(); }
    static void destroy({{ api }}::{{ r.handle_type }}& v) { {{ api }}::{{ r.delete_func_name }}(v); }
    static bool valid(const {{ api }}::{{ r.handle_type }}& v) { return static_cast<bool>(v); }
};
{% endfor %}
} // namespace glaze

#endif // __GLAZE_{{ api_upper }}_HPP__
