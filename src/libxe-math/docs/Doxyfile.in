# Doxygen configuration template for libxe-math.
#
# Configured via `configure_file()` from src/libxe-math/CMakeLists.txt when
# the engine-wide `XE_DEV_DOCS` option is ON. Variables of the form
# @VARNAME@ are substituted by CMake at configure time; everything else is
# a literal Doxygen setting.

PROJECT_NAME           = "xe-math"
PROJECT_NUMBER         = "@XE_VERSION@"
PROJECT_BRIEF          = "GLM-style math library for the XE game engine"

OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@/docs

# Source layout: every public header lives under src/xe/math.
INPUT                  = @CMAKE_CURRENT_SOURCE_DIR@/src/xe/math
RECURSIVE              = YES
FILE_PATTERNS          = *.h
STRIP_FROM_PATH        = @CMAKE_CURRENT_SOURCE_DIR@/src

# Documentation policy: we explicitly comment what is public, so do NOT
# auto-extract everything. Anything left undocumented after the planned
# Doxygen pass is a bug and should fail the audit.
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_PACKAGE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
# Start permissive; flip to YES once the warning count is at zero.
WARN_AS_ERROR          = NO

# C++17 source.
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
INLINE_INHERITED_MEMB  = NO
TAB_SIZE               = 4
ALIASES                =

# We want template parameters to show up in declarations.
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_HEADERFILE        = YES
SORT_MEMBER_DOCS       = NO
SORT_BRIEF_DOCS        = NO

# Output format toggles.
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = YES

GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO

# XML output is kept so future tooling (Sphinx/Breathe, doxygen2html, etc.)
# can consume the same data without re-running Doxygen.
GENERATE_XML           = YES
XML_OUTPUT             = xml

# Plane.h uses @f$ ... @f$ for the plane equation, so MathJax must be on.
USE_MATHJAX            = YES
MATHJAX_FORMAT         = HTML-CSS

# Source browsing aids.
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = NO
REFERENCES_RELATION    = NO

# C++17 features that the parser sometimes mis-handles.
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = NO

# Dot graphs are nice but require Graphviz; gate behind whatever the build
# environment provides. Leaving on by default and letting Doxygen warn is
# the simplest path.
HAVE_DOT               = YES
DOT_NUM_THREADS        = 0
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES

QUIET                  = NO
